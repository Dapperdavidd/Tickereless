TICKERLESS_API_HOST=127.0.0.1
TICKERLESS_API_PORT=8080
# Railway supplies PORT automatically; it takes precedence when present.
DATABASE_URL=postgres://tickerless:tickerless@127.0.0.1:5432/tickerless
RUST_LOG=tickerless_api=info,actix_web=info

# Google OAuth client IDs accepted in mobile ID-token `aud` claims.
# Use the Web application client ID ending in .apps.googleusercontent.com.
# Separate multiple allowed IDs with commas. A client secret is not required.
GOOGLE_OAUTH_CLIENT_IDS=

# Mobile wallet plumbing. Public endpoints are suitable for development only;
# use a dedicated Solana RPC provider before production release.
TICKERLESS_SOLANA_RPC_URL=https://api.devnet.solana.com
TICKERLESS_SOLANA_WEBSOCKET_URL=wss://api.devnet.solana.com
